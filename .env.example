LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Опционально. Укажите уровень, только если модель и провайдер его поддерживают.
# LLM_REASONING_EFFORT=medium

# Встроенный LiteLLM для Gemini. Заполните от одного до четырёх ключей.
# Чтобы использовать высокий уровень рассуждения, задайте LLM_REASONING_EFFORT=high.
# LITELLM_API_KEY_1=
# LITELLM_API_KEY_2=
# LITELLM_API_KEY_3=
# LITELLM_API_KEY_4=
# LITELLM_MODEL=gemini-3.5-flash-lite
# LITELLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Groq с Qwen 3.8. Можно указать один ключ или JSON-массив.
# GROQ_API_KEY='["", ""]'
